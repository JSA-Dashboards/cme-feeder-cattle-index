__pycache__/
*.py[cod]
*.egg-info/

# Secrets — MARS_API_KEY is only ever set as an env var, never committed
.env
.env.*
.streamlit/secrets.toml
.streamlit/secrets.local.toml

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Excel lock files
~$*.xlsx

*.log

# NOTE: data/Feeder Cattle Info Ross.xlsx and data/mars_history.db are
# intentionally NOT ignored, but NOT because the deployment needs them.
# Production reads SNOWFLAKE (JSA.CME_FEEDER_CATTLE) -- see snowflake_db.py and
# snowflake/02_migrate_data.py. The committed .db is a local-dev seed so a fresh
# clone has data without re-running the whole USDA backfill.
#
# So do NOT commit the .db on every refresh: it is ~6.5 MB of binary, which is
# ~2.4 GB of history per year if the daily job commits it. Push data to
# Snowflake instead; commit the .db only when the seed is meaningfully stale.
# (An earlier version of this note said the file had to be committed for
# Streamlit Cloud to show anything. That predates the Snowflake cutover.)

# Scheduled-run logs (scripts/daily_update.ps1)
logs/
# Local DB backups
data/*.db.bak-*
# SQLite WAL/SHM sidecars - transient; daily_update.ps1 checkpoints them into the .db
data/*.db-wal
data/*.db-shm

# Scratch downloads (AMS video-sale PDFs fetched during parsing)
.tmp/

# Local dev launcher. Points at a session-specific scratchpad path and loads
# .env into a Streamlit process for testing the portal against Snowflake --
# useful on this machine, meaningless anywhere else.
.claude/
